---
/**
 * Theme toggle — the only JavaScript on a guidance page.
 *
 * WHY THIS IS NOT A REACT ISLAND
 * `docs/spec/ui-design-system.md` says React is for islands and "only the
 * calculator hydrates"; `site-architecture.md` says guidance pages ship zero
 * JavaScript. Hydrating React here would put ~45 KB of runtime on every
 * guidance page for one button, and the audience for those pages is explicitly
 * "frequently on a phone with a poor connection". P01's prompt calls this a
 * "small island"; this is the smallest form of that which honours the specs.
 * The compiled script is well under 1 KB.
 *
 * PROGRESSIVE ENHANCEMENT
 * The button is rendered `hidden` and unhidden by its own script. Without
 * JavaScript there is no dead control to press, and the page still themes
 * itself correctly from `prefers-color-scheme`. A visible button that does
 * nothing is worse than no button.
 *
 * The pre-paint script that applies the stored choice lives in `Base.astro`'s
 * <head>, because it has to run before first paint or the user sees a flash of
 * the wrong theme.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle touch-target"
  hidden
  data-label-to-dark="Switch to dark theme"
  data-label-to-light="Switch to light theme"
>
  {
    /* Both icons ship; CSS shows whichever matches the resolved theme, so the
      button never waits on JS to look right. Decorative — the accessible name
      comes from the aria-label the script sets. */
  }
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  // Kept in step with the pre-paint script in Base.astro and with the
  // :root[data-theme] rules in global.css.
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  if (button instanceof HTMLButtonElement) {
    /** What the page is actually showing right now. */
    const resolved = (): 'light' | 'dark' => {
      const explicit = root.dataset['theme'];
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const describe = () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      // The accessible name states the action, not the current state, so it is
      // unambiguous when read out of context.
      const label =
        next === 'dark'
          ? (button.dataset['labelToDark'] ?? 'Switch to dark theme')
          : (button.dataset['labelToLight'] ?? 'Switch to light theme');
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    };

    button.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset['theme'] = next;
      try {
        window.localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Storage can be unavailable (private mode, blocked cookies). The theme
        // still applies for this page view; it just will not be remembered.
        // Failing to persist a preference must never break the page.
      }
      describe();
    });

    // If the user has expressed no explicit preference, keep following the OS.
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!root.dataset['theme']) describe();
    });

    describe();
    button.hidden = false;
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color var(--duration-state) var(--ease-out-soft),
      border-color var(--duration-state) var(--ease-out-soft);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent);
  }

  /* Focus is not restated here — the base layer gives every focusable element a
     2px --color-focus ring at a 2px offset, and that is deliberately the one
     place it is defined. */

  .theme-toggle__icon {
    /* Icons are swapped by CSS so the correct one is painted on first frame,
       before the script runs. */
    display: none;
  }

  .theme-toggle__icon--moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle__icon--moon {
      display: none;
    }

    :root:not([data-theme='light']) .theme-toggle__icon--sun {
      display: block;
    }
  }

  :root[data-theme='dark'] .theme-toggle__icon--moon {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle__icon--sun {
    display: block;
  }

  :root[data-theme='light'] .theme-toggle__icon--moon {
    display: block;
  }

  :root[data-theme='light'] .theme-toggle__icon--sun {
    display: none;
  }
</style>
