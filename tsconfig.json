{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "src", "astro.config.mjs", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", ".astro/**/*.js", "scripts"]
}
